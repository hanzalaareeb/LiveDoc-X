# PostgreSQL + pgvector connection string

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/live_docx

SECRET_KEY="replace-this-with-at-least-32-random-characters"

DEBUG=True

LOG_LEVEL="INFO"

ALLOWED_HOSTS=localhost,127.0.0.1

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

REDIS_URL=redis://127.0.0.1:6379/1

# Bytes; defaults to 25 MiB.
DOCUMENT_UPLOAD_MAX_SIZE=26214400
